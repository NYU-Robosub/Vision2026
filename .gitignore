# ROS 2 / colcon generated workspace artifacts
/ros_ws/build/
/ros_ws/install/
/ros_ws/log/
__pycache__/
.pytest_cache/

# Local ROS data captures and generated model artifacts
/data/rosbags/*
/data/svo/bottom/*
/data/svo/front/*
/models/onnx/*
/models/tensorrt/*
/models/weights/*
/maps/spatial_mapping/*.ply

# Preserve empty directory placeholders
!/data/rosbags/.gitkeep
!/data/svo/bottom/.gitkeep
!/data/svo/front/.gitkeep
!/models/onnx/.gitkeep
!/models/tensorrt/.gitkeep
!/models/weights/.gitkeep
!/maps/spatial_mapping/.gitignore
